{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "5harness-cloud-worker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist-worker",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/authorize",
      "/oauth/*",
      "/.well-known/*",
      "/mcp"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "6243f68a2e5345459081e0ed99d6f553"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "harness5",
    "FIREBASE_API_KEY": "AIzaSyCvV_Hdl36iwuH3tolYwAJaj7xgthvrvL8",
    "CORS_ORIGINS": "https://5harness-cloud.pages.dev"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
