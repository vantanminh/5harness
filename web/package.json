{
  "name": "@5harness/web",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare-hosted Harness cloud dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=5harness-cloud",
    "deploy:preview": "npm run build && wrangler pages deploy dist --project-name=5harness-cloud --branch=preview"
  },
  "dependencies": {
    "firebase": "^11.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.5",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
