rules_version = '2';

// The web and CLI clients never talk to Firestore directly.  All reads and
// writes go through the Functions API, which verifies Firebase/Auth/App Check
// and applies quotas before using the Admin SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
