# Copy to .env for local emulator/deploy configuration. Never commit .env.
# Comma-separated exact web origins; wildcard origins are not supported.
WEB_ORIGINS=http://localhost:5173,https://your-project.pages.dev

# Keep true in deployed environments after Firebase App Check is configured.
ENFORCE_APP_CHECK=true

# Emulator-only value used to hash IP keys before they are written to Firestore.
# Production uses Firebase Secret Manager instead; set it with:
#   firebase functions:secrets:set RATE_LIMIT_SALT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-32-byte-random-secret
